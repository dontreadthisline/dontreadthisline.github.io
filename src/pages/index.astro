---
// 首页：签名 → 三领域入口卡 → 陈列柜（精选作品）→ 流水（笔记）→ aha room
import Base from '../layouts/Base.astro';
import Underline from '../components/Underline.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { works } from '../data/works';
import { ahas } from '../data/ahas';
import { fields } from '../data/fields';
import Emblem from '../components/Emblem.astro';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const aha = ahas[0];

const doneCount = (f: (typeof fields)[number]) => f.books.filter((b) => b.href).length;
---

<Base title="aha room — 作品与学习笔记">
  <!-- 签名 -->
  <section class="hero">
    <div class="signline">
      <span class="hand">dontreadthisline</span>
      <svg width="150" height="8" viewBox="0 0 150 8" fill="none" aria-hidden="true">
        <path d="M2 5 C 30 1, 60 8, 90 4 S 130 2, 148 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </div>
    <h1>
      保持最纯粹的好奇心，做一个依然愿意在<Underline>海边捡拾贝壳</Underline>的人。
    </h1>
  </section>

  <!-- 三领域入口 -->
  <section class="fields">
    <h2 class="sec-h"><span class="hand-t">fields</span>领域</h2>
    <div class="cards">
      {fields.map((f) => (
        <a href={`/${f.key}/`} class="card field-card">
          <div class="frow">
            <div>
              <div class="fhead">
                <span class="fname">{f.name}</span>
                <span class="hand-s">{f.hand}</span>
              </div>
              <p class="fmotto">{f.motto}</p>
            </div>
            <div class="femb"><Emblem emblem={f.emblem} /></div>
          </div>
          <div class="fstat">
            {doneCount(f) > 0 ? (
              <span class="mono">{doneCount(f)} 本成书 · 共 {f.books.length} 项</span>
            ) : (
              <span class="mono">还没成书 · {f.books.length} 项在攒</span>
            )}
          </div>
          <div class="flatest">
            <span class="fl-label">最新</span>
            <span class="fl-title">{f.books[0].title}</span>
            <svg class="arr" width="24" height="11" viewBox="0 0 24 11" fill="none" aria-hidden="true">
              <path d="M1 6 C 7 3, 15 8, 21 5 M17 2 L22 5 L17 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </div>
        </a>
      ))}
    </div>
    <!-- 架板装饰 -->
    <svg class="board" viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true">
      <path d="M4 5 C 160 1, 340 9, 520 5 S 840 2, 996 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
    </svg>
  </section>

  <!-- 陈列柜：精选作品 -->
  <section class="cabinet">
    <h2 class="sec-h"><span class="hand-t">cabinet</span>陈列柜 · 作品集 <a href="/works/" class="more">全部 →</a></h2>
    {works.map((w) => (
      <a href={w.href} class="card work-card">
        <svg class="mini" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <circle cx="10" cy="24" r="5" class="n" />
          <circle cx="24" cy="10" r="5" class="n" />
          <circle cx="24" cy="38" r="5" class="n" />
          <circle cx="40" cy="24" r="5" class="n acc" />
          <path d="M14 21 C 18 16, 19 14, 21 12 M14 27 C 18 32, 19 34, 21 36 M28 12 C 33 15, 35 18, 37 21 M28 36 C 33 33, 35 30, 37 27" class="e" />
        </svg>
        <div>
          <div class="wtitle">
            {w.title}
            <svg class="arr" width="26" height="12" viewBox="0 0 26 12" fill="none" aria-hidden="true">
              <path d="M1 6 C 8 3, 16 9, 23 6 M19 2 L24 6 L19 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </div>
          <p class="tagline">{w.tagline}</p>
          <div class="meta-row">
            <span>{w.lang}</span>
            <span class="sep">/</span>
            <span>{w.lines}</span>
            <span class="sep">/</span>
            <StatusBadge status={w.status} />
          </div>
        </div>
      </a>
    ))}
  </section>

  <!-- 流水：笔记 -->
  <section class="flow">
    <h2 class="sec-h"><span class="hand-t">journal</span>流水 · 笔记 <a href="/notes/" class="more">全部 →</a></h2>
    <ul class="notelist">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}/`} class="ntitle">{n.data.title}</a>
          <span class="nmeta">
            <time>{fmt(n.data.date)}</time>
            <StatusBadge status={n.data.status} />
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- aha room -->
  <section class="aharoom">
    <div class="head">
      <span class="hand-m">aha room</span>
      <span class="fine">最近一次顿悟</span>
    </div>
    <div class="quote">
      <p>{aha.text}</p>
      <a class="from" href={aha.href}>— {aha.from}，{aha.date}</a>
    </div>
  </section>
</Base>

<style>
  .hero { max-width: var(--wide); margin: 0 auto; padding: 3.2rem 28px 2.2rem; }
  .signline { display: flex; align-items: baseline; gap: 14px; }
  .signline .hand { font: 600 30px/1 var(--hand); color: var(--ink); }
  .signline svg { color: var(--accent); align-self: center; }
  .hero h1 { font-family: var(--serif); font-size: clamp(1.5rem, 3.4vw, 2.15rem); line-height: 1.65; margin-top: 1.3rem; }

  .fields, .cabinet, .flow, .aharoom { max-width: var(--wide); margin: 0 auto; padding: 0 28px; }

  .sec-h {
    font-family: var(--serif);
    font-size: 1.15rem;
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-bottom: 1.6px solid var(--line);
    padding-bottom: 0.5rem;
    margin: 2.6rem 0 1.2rem;
  }
  .hand-t { font: 600 22px/1 var(--hand); color: var(--accent); margin-right: 2px; }
  .more { margin-left: auto; font-family: var(--sans); font-size: 13px; font-weight: 400; color: var(--dim); }
  .more:hover { color: var(--accent); }

  /* ---------- 领域入口卡 ---------- */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; padding-top: 0.4rem; }
  @media (max-width: 820px) { .cards { grid-template-columns: 1fr; gap: 14px; } }

  .field-card { padding: 18px 22px 16px; display: flex; flex-direction: column; }
  .frow { display: flex; gap: 14px; align-items: flex-start; }
  .frow > div:first-child { flex: 1; }
  .femb { width: 74px; flex: none; margin-top: 2px; }
  .fhead { display: flex; align-items: baseline; gap: 10px; }
  .fname { font-family: var(--serif); font-size: 1.3rem; font-weight: 700; }
  .field-card:hover .fname { color: var(--accent-deep); }
  .hand-s { font: 600 19px/1 var(--hand); color: var(--dim); }
  .fmotto { font-family: var(--serif); font-size: 13.5px; color: var(--dim); margin: 0.3rem 0 0.9rem; }
  .fstat { font-size: 12px; color: var(--faint); }
  .mono { font-family: var(--mono); font-size: 11.5px; }

  .flatest {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-top: 1px dashed var(--line);
  }
  .fl-label { font: 500 17px/1 var(--hand); color: var(--faint); }
  .fl-title { font-family: var(--serif); font-size: 0.98rem; color: var(--ink); flex: 1; }
  .field-card:hover .fl-title { color: var(--accent-deep); }

  .board { color: var(--accent); opacity: 0.5; width: 100%; height: 10px; display: block; margin-top: 14px; }

  /* ---------- 陈列柜 ---------- */
  .work-card { display: flex; gap: 18px; align-items: flex-start; margin-bottom: 1rem; }
  .mini { width: 48px; flex: none; margin-top: 4px; }
  .mini .n { fill: var(--bg); stroke: var(--accent); stroke-width: 1.8; }
  .mini .n.acc { fill: var(--accent); }
  .mini .e { stroke: var(--line-strong); stroke-width: 1.8; fill: none; stroke-linecap: round; }
  .wtitle { font-family: var(--serif); font-size: 1.25rem; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 10px; }
  .work-card:hover .wtitle { color: var(--accent-deep); }
  .tagline { font-size: 14px; color: var(--dim); margin: 0.35rem 0 0.7rem; }

  /* ---------- 流水 ---------- */
  .notelist { list-style: none; }
  .notelist li { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 0.72rem 2px; border-bottom: 1px dashed var(--line); }
  .ntitle { font-family: var(--serif); font-size: 1.02rem; color: var(--ink); flex: 1; }
  .ntitle:hover { color: var(--accent-deep); }
  .nmeta { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12px; color: var(--faint); white-space: nowrap; }

  /* ---------- aha room ---------- */
  .aharoom { margin: 3rem auto 0; padding-bottom: 3.4rem; }
  .aharoom .head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 0.7rem; }
  .hand-m { font: 600 26px/1 var(--hand); color: var(--accent); }
  .aharoom .fine { font-size: 12.5px; color: var(--faint); }
  .quote { background: var(--wash); border: 1.6px solid var(--line-strong); border-radius: var(--r-sketch); padding: 18px 26px; }
  .quote p { font-family: var(--serif); color: #414c59; }
  .from { display: block; text-align: right; font: 500 18px/1 var(--hand); color: var(--dim); margin-top: 8px; }
</style>
