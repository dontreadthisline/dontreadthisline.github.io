---
// Emblem: 领域徽记（手绘 SVG）。首页入口卡（小）与领域落地页（大）共用。
// 新领域不传 emblem 时回退为手绘打开的书。
interface Props {
  emblem?: 'riemann' | 'nabla' | 'graph';
}
const { emblem } = Astro.props;
---

{emblem === 'riemann' && (
  <svg viewBox="0 0 240 160" fill="none" aria-hidden="true">
    <!-- 黎曼和：曲线下的一排矩形 -->
    <rect x="30" y="72" width="24" height="52" class="bar" />
    <rect x="54" y="46" width="24" height="78" class="bar" />
    <rect x="78" y="32" width="24" height="92" class="bar" />
    <rect x="102" y="28" width="24" height="96" class="bar" />
    <rect x="126" y="34" width="24" height="90" class="bar" />
    <rect x="150" y="52" width="24" height="72" class="bar" />
    <rect x="174" y="78" width="24" height="46" class="bar" />
    <path d="M18 124 L 212 124" class="axis" />
    <path d="M24 96 C 70 92, 88 30, 140 26 C 176 23, 196 56, 216 40" class="curve" />
  </svg>
)}
{emblem === 'nabla' && (
  <svg viewBox="0 0 240 160" fill="none" aria-hidden="true">
    <!-- nabla 算子 + 发散场线 -->
    <path d="M120 34 L 96 88 L 144 88 Z" class="nabla" />
    <path d="M120 60 C 90 58, 62 66, 40 82 M46 76 L 40 83 L 48 84" class="flux" />
    <path d="M120 60 C 150 58, 178 66, 200 82 M194 76 L 200 83 L 192 84" class="flux" />
    <path d="M108 72 C 96 96, 96 118, 104 138 M98 132 L 104 139 L 110 133" class="flux" />
    <path d="M132 72 C 144 96, 144 118, 136 138 M142 132 L 136 139 L 130 133" class="flux" />
    <path d="M120 66 L 120 26 M115 32 L 120 25 L 125 32" class="flux" />
  </svg>
)}
{emblem === 'graph' && (
  <svg viewBox="0 0 240 160" fill="none" aria-hidden="true">
    <!-- 计算图：两入一出，一个节点被手绘圈注 -->
    <circle cx="42" cy="52" r="13" class="node" />
    <circle cx="42" cy="110" r="13" class="node" />
    <circle cx="122" cy="58" r="13" class="node" />
    <circle cx="122" cy="104" r="13" class="node acc" />
    <circle cx="200" cy="80" r="13" class="node out" />
    <path d="M56 56 C 82 54, 94 56, 108 57" class="edge" />
    <path d="M56 106 C 82 106, 94 105, 108 104" class="edge" />
    <path d="M134 60 C 164 62, 172 70, 186 75" class="edge" />
    <path d="M134 102 C 164 100, 172 92, 186 86" class="edge" />
    <path d="M121 91 C 106 104, 108 126, 128 130 C 146 134, 160 122, 154 106 C 150 94, 136 89, 121 91" class="ring" />
    <text x="128" y="158" text-anchor="middle" class="hand-note">bwd</text>
  </svg>
)}
{!emblem && (
  <svg viewBox="0 0 240 160" fill="none" aria-hidden="true">
    <!-- 打开的书（默认徽记） -->
    <path d="M120 44 C 96 28, 60 26, 34 34 L 34 122 C 60 114, 96 116, 120 130 C 144 116, 180 114, 206 122 L 206 34 C 180 26, 144 28, 120 44 Z M120 44 L 120 130" class="book" />
    <path d="M52 52 C 72 48, 96 50, 110 58 M52 68 C 72 64, 96 66, 110 74 M52 84 C 68 81, 88 82, 102 88 M130 58 C 144 50, 168 48, 188 52 M130 74 C 144 66, 168 64, 188 68 M130 88 C 142 82, 160 81, 176 85" class="lines" />
  </svg>
)}

<style>
  svg { width: 100%; height: auto; display: block; }
  .bar { fill: rgba(58, 74, 168, 0.10); stroke: var(--accent); stroke-width: 1.6; opacity: 0.8; }
  .axis { stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; opacity: 0.8; }
  .curve { stroke: var(--accent-deep); stroke-width: 2.2; stroke-linecap: round; }
  .nabla { stroke: var(--accent); stroke-width: 2.4; stroke-linejoin: round; fill: rgba(58, 74, 168, 0.08); }
  .flux { stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; fill: none; opacity: 0.75; }
  .node { fill: var(--bg); stroke: var(--accent); stroke-width: 1.8; }
  .node.acc { fill: var(--panel); }
  .node.out { stroke-width: 2.4; }
  .edge { stroke: #5a6b7d; stroke-width: 1.7; stroke-linecap: round; fill: none; }
  .ring { stroke: var(--accent-deep); stroke-width: 1.7; stroke-linecap: round; fill: none; opacity: 0.8; }
  .hand-note { font: 600 18px var(--hand); fill: var(--dim); }
  .book { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; fill: rgba(58, 74, 168, 0.05); }
  .lines { stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; opacity: 0.6; }
</style>
