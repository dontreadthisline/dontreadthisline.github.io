---
// note.astro: 笔记正文排版。衬线正文 + KaTeX + 代码块。
import Base from './base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { render } from 'astro:content';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data.date;
const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={`${entry.data.title} — workbench`} description={entry.data.summary}>
  <article class="note">
    <header>
      <p class="kicker">note</p>
      <h1>{entry.data.title}</h1>
      <div class="meta-row">
        <time datetime={d.toISOString().slice(0, 10)}>{dateStr}</time>
        <span class="sep">/</span>
        <StatusBadge status={entry.data.status} />
        {entry.data.tags.length > 0 && (
          <span class="sep">/</span>
          <span>{entry.data.tags.join(' · ')}</span>
        )}
      </div>
      {entry.data.summary && <p class="lede">{entry.data.summary}</p>}
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.marginalia && (
        <aside class="note-paper">
          <p class="head">回头看</p>
          <p>{entry.data.marginalia}</p>
        </aside>
      )
    }

    <p class="prev">
      <a href="/notes/">← 回笔记列表</a>
    </p>
  </article>
</Base>

<style>
  .note {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3.2rem 24px 0;
  }

  header {
    margin-bottom: 2.4rem;
  }

  h1 {
    font-family: var(--serif);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0.3rem 0 0.7rem;
  }

  .lede {
    margin-top: 1.1rem;
    font-family: var(--serif);
    color: var(--dim);
    font-size: 1.02rem;
  }

  /* 正文排版 */
  .prose {
    font-family: var(--serif);
    font-size: 1.03rem;
  }

  .prose p { margin: 1.1em 0; }
  .prose h2 {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 2.2em 0 0.8em;
    padding-bottom: 0.35em;
    border-bottom: 1.6px solid var(--line);
  }
  .prose h3 {
    font-family: var(--serif);
    font-size: 1.12rem;
    margin: 1.8em 0 0.6em;
  }
  .prose ul, .prose ol { padding-left: 1.6em; margin: 1.1em 0; }
  .prose li { margin: 0.35em 0; }
  .prose blockquote {
    margin: 1.4em 0;
    padding: 0.2em 1.2em;
    border-left: 3px solid var(--line-strong);
    color: #55606e;
  }
  .prose code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--panel);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose pre {
    margin: 1.4em 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
    background: #fbfcfe;
  }
  .prose pre code {
    background: none;
    padding: 0;
    font-size: 1em;
  }
  .prose .katex-display {
    margin: 1.4em 0;
    overflow-x: auto;
    padding: 0.3em 0;
  }
  .prose img { border-radius: 6px; }
  .prose hr {
    border: none;
    border-top: 1px dashed var(--line-strong);
    margin: 2.4em 0;
  }

  .prev {
    margin-top: 3rem;
    font-size: 14px;
  }
</style>
