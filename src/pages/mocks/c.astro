---
// Mock C · 封面式：整屏一句话 + 下滚见内容
import base from '../../layouts/base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
---

<base title="Mock C · 封面式 — workbench">
  <section class="cover">
    <p class="hand">hello —</p>
    <h1>
      把六百行代码<br />写成一本<em>能读完的书</em>。
    </h1>
    <div class="scrollcue" aria-hidden="true">
      <svg width="20" height="46" viewBox="0 0 20 46" fill="none">
        <path d="M10 2 C 8 12, 12 22, 10 32 M4 27 C 6 31, 8 34, 10 37 C 12 33, 14 31, 16 28" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" />
      </svg>
    </div>
  </section>

  <section class="body">
    <h2 class="hand-h">作品</h2>
    <a class="entry work" href="https://dontreadthisline.github.io/tinyautograd/">
      <span class="t">tinyautograd</span>
      <span class="g">MLX 之上约六百行的自动微分框架，配一本设计之书</span>
      <span class="m mono">Python · ~600 行 · 2026</span>
    </a>

    <h2 class="hand-h">最近在写</h2>
    <a class="entry" href="/notes/hello-blog/">
      <span class="t">这个博客是怎么搭起来的</span>
      <span class="m mono">2026.11.21</span>
    </a>
    <a class="entry" href="/notes/thompson-nfa/">
      <span class="t">Thompson 构造：正则如何在纸上变成状态机</span>
      <span class="m mono">2026.11.19</span>
    </a>

    <p class="about-line">
      <a href="/about/">关于这块工作台 →</a>
    </p>
  </section>
</base>

<style>
  .cover {
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem 24px;
  }
  .cover .hand { font: 600 32px/1 var(--hand); color: var(--accent); transform: rotate(-2deg); }
  .cover h1 { font-family: var(--serif); font-size: clamp(2rem, 5.2vw, 3.2rem); line-height: 1.6; margin: 1.2rem 0 0; }
  .cover em { font-style: normal; border-bottom: 3px solid var(--line-strong); }

  .scrollcue {
    margin-top: 3rem;
    color: var(--accent);
    animation: drift 2.6s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0); opacity: 0.9; }
    50% { transform: translateY(9px); opacity: 0.45; }
  }

  .body { max-width: var(--max); margin: 0 auto; padding: 1rem 24px 3rem; }

  .hand-h { font: 600 1.9rem/1 var(--hand); color: var(--accent); margin: 2.4rem 0 0.8rem; }

  .entry {
    display: flex; align-items: baseline; gap: 16px;
    padding: 0.85rem 4px;
    border-bottom: 1px dashed var(--line);
    color: var(--ink);
  }
  .entry:hover .t { color: var(--accent-deep); }
  .entry .t { font-family: var(--serif); font-size: 1.08rem; flex: 1; }
  .entry.work { flex-wrap: wrap; }
  .entry.work .t { flex: none; font-size: 1.3rem; font-weight: 700; }
  .entry.work .g { flex-basis: 100%; font-size: 14px; color: var(--dim); order: 3; }
  .entry.work .m { order: 2; }
  .mono { font-family: var(--mono); font-size: 12px; color: var(--faint); white-space: nowrap; }

  .about-line { margin-top: 3rem; font-size: 14px; }
</style>
