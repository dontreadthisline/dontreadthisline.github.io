---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '一个程序员的个人博客：作品与学习笔记。' } = Astro.props;
import '../styles/tokens.css';
import '../styles/hand.css';
import 'katex/dist/katex.min.css';
import { SITE_NAME, NAV } from '../data/nav';

// 手绘导航徽记（16px，与 nav.ts 的 icon 字段对应；新 icon 在这里加一个分支）
const icons: Record<string, string> = {
  // 陈列柜：歪矩形 + 中横线 + 两个把手
  cabinet: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3 3.8 L14 3.2 L14.5 13.2 L3.4 13.6 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M3.2 8.7 L14.3 8.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    <circle cx="6.2" cy="6.2" r="0.9" fill="currentColor"/>
    <circle cx="11.2" cy="10.6" r="0.9" fill="currentColor"/>
  </svg>`,
  // 笔记：纸 + 折角 + 三行字
  journal: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3.6 2.6 H10.4 L13.2 5.4 V13.4 H3.6 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M10.4 2.6 V5.4 H13.2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M5.6 8 H10.6 M5.6 10 H9.4 M5.6 12 H8.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>`,
  // 山：折线主峰 + 小旗（about 页 by foot 的呼应）
  peak: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M1.8 13 L6.4 4.8 L9 8.6 L11 5.8 L14.6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6.4 4.8 V2.6 L8.4 3.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
  // 书：打开的书（备用）
  book: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 4.2 C6.4 3 4 3 2.4 3.6 V12.4 C4 11.8 6.4 11.8 8 13 C9.6 11.8 12 11.8 13.6 12.4 V3.6 C12 3 9.6 3 8 4.2 Z M8 4.2 V13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
};

const links = NAV;
const here = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/caveat-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <nav class="nav">
      <div class="bar">
        <a href="/" class="brand" aria-label="首页">
          <span class="name" set:html={SITE_NAME} />
          <svg width="118" height="7" viewBox="0 0 118 7" fill="none" aria-hidden="true">
            <path
              d="M2 4 C 24 1, 48 7, 64 4 S 96 2, 116 4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </a>
        <div class="links">
          {links.map((l) => (
            <a href={l.href} class={here(l.href) ? 'active' : ''}>
              <span class="icon" set:html={icons[l.icon]} />
              <span class="label">{l.label}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>
